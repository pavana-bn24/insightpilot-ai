# InsightPilot AI - environment configuration
# Copy to backend/.env and fill in values.

# Optional: enables LLM-based planning & insight phrasing.
# Leave blank to run in deterministic (offline) mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Backend server
HOST=0.0.0.0
PORT=8000
